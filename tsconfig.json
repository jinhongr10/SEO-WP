{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "appTabs.ts",
    "index.tsx",
    "types.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "services/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "api/**/*.ts",
    "vite.config.ts",
    "test_product.ts",
    "test_meta.cjs"
  ],
  "exclude": [
    "node_modules",
    "backup",
    "build",
    "data",
    "dist",
    "dist-cli",
    "keys",
    "release",
    "state",
    "tmp",
    "desktop/resources",
    "test_product.ts"
  ]
}
