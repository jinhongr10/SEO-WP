{
  "name": "seo-wp-sync",
  "private": true,
  "version": "0.1.2",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-all.cjs",
    "dev:frontend": "vite",
    "dev:backend": "source .venv/bin/activate && uvicorn backend.main:app --reload --port 3004 --reload-dir backend",
    "dev:all": "node scripts/dev-all.cjs",
    "desktop:dev": "node desktop/dev-runner.cjs",
    "desktop:start": "electron .",
    "build": "npm run build:web && npm run build:cli",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "test:frontend": "node --import tsx --test src/tests/*.test.ts",
    "test:ui-layout": "playwright test --config=playwright.ui-layout.config.ts",
    "test:interactions": "playwright test --config=playwright.app-interactions.config.ts",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "test:neutrality": "node scripts/verification/neutrality-guard.mjs",
    "check:fast": "node scripts/verify.mjs fast",
    "verify:changed": "node scripts/verify.mjs changed",
    "verify:release": "node scripts/verify.mjs release",
    "review:changed": "node scripts/review-changed.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:smoke:packaged": "node scripts/packaged-desktop-smoke.mjs",
    "test:artifact:windows": "node scripts/verification/artifact-neutrality-guard.mjs --root release/desktop/win-unpacked",
    "qa:windows:real-account": "node scripts/windows-real-account-qa.mjs",
    "release:stage": "node scripts/release/stage-release.mjs",
    "verify:ui": "npm run build:web && npm run test:frontend && npm run test:ui-layout && npm run test:interactions",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "verify": "npm run typecheck && npm run test:frontend && npm run test:backend",
    "build:web": "vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:desktop": "bash scripts/build-macos-desktop.sh",
    "build:desktop:mac": "bash scripts/build-macos-desktop.sh",
    "build:desktop:mac:release": "PUBLISH=always ELECTRON_BUILDER_CONFIG=electron-builder.release.json bash scripts/build-macos-desktop.sh",
    "build:desktop:backend:mac": "bash scripts/build-macos-backend.sh",
    "prepare:desktop:node-runtime": "bash scripts/prepare-macos-node-runtime.sh",
    "build:desktop:mac:arm64": "electron-builder --mac dmg zip --arm64 --publish never",
    "build:desktop:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-desktop.ps1",
    "build:desktop:windows:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-desktop.ps1 -Release",
    "build:desktop:backend:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-backend.ps1",
    "prepare:desktop:node-runtime:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-windows-node-runtime.ps1",
    "build:desktop:windows:x64": "electron-builder --win nsis --x64",
    "preview": "vite preview",
    "media:scan": "node --import tsx src/cli.ts scan",
    "media:run": "node --import tsx src/cli.ts run",
    "media:rollback": "node --import tsx src/cli.ts rollback",
    "media:report": "node --import tsx src/cli.ts report",
    "media:dashboard": "node --import tsx src/cli.ts dashboard",
    "media:watch": "node --import tsx src/cli.ts watch",
    "media:cache": "node --import tsx src/cli.ts cache",
    "test": "node --import tsx --test src/tests/*.test.ts"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.15",
    "@google/genai": "^1.38.0",
    "axios": "^1.12.2",
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "https-proxy-agent": "^7.0.6",
    "p-limit": "^7.2.0",
    "pino": "^9.12.0",
    "sharp": "^0.34.4",
    "ssh2-sftp-client": "^12.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/ssh2-sftp-client": "^9.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "marked": "12.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "xlsx": "0.18.5"
  }
}
