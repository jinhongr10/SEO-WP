{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "jsx": "preserve",
    "rootDir": "src",
    "outDir": "dist-cli",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "allowImportingTsExtensions": false
  },
  "include": ["src/cli.ts"]
}
