# WordPress REST
WP_BASE_URL=https://example.com
WP_USER=your_wp_user
WP_APP_PASSWORD=your_app_password
# Optional JWT auth. If set, it will be used instead of Basic Auth.
# WP_JWT=your_jwt_token

# Optional: dynamic-IP friendly Cloudflare bypass for WordPress REST.
# Add the same name/value to Settings or env, then create a Cloudflare Skip rule
# matching /wp-json/* requests that include this exact header value.
# WP_REST_BYPASS_HEADER_NAME=X-LensCraft-REST-Token
# WP_REST_BYPASS_HEADER_VALUE=replace_with_a_long_random_secret

# WooCommerce REST API keys, recommended for product scanning/sync.
WC_CONSUMER_KEY=ck_your_consumer_key
WC_CONSUMER_SECRET=cs_your_consumer_secret

# SFTP (Cloudways-compatible)
SFTP_HOST=example.sftp.host
SFTP_PORT=22
SFTP_USER=master
SFTP_PASSWORD=your_sftp_password
# Optional: private key auth
# SFTP_PRIVATE_KEY_PATH=/absolute/path/to/key.pem

REMOTE_WP_ROOT=/home/master/applications/<app_id>/public_html
UPLOADS_RELATIVE=wp-content/uploads

CONCURRENCY=5
AI_BATCH_CONCURRENCY=10
PER_PAGE=100
MAX_PAGES=9999
DRY_RUN=true

# AI Configuration
# For Docker/server deployment, prefer Vertex AI so credentials stay backend-only.
# Internal CLI tasks still use LLM_PROVIDER=gemini to select Google's Gemini model;
# GOOGLE_GENAI_USE_VERTEXAI=true makes those calls authenticate through Vertex.
LLM_PROVIDER=gemini # Options: none, gemini
GEMINI_API_KEY= # Optional fallback only when not using Vertex AI
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/app/keys/vertex-sa.json
# GENAI_FLASH_MODEL=gemini-2.5-flash
# LLM_API_KEY= # Deprecated/Custom
# Optional comma-separated seed keywords. Leave empty for a neutral app default.
DEFAULT_KEYWORDS=
ALT_MAX_CHARS=125

# Network proxy (e.g. Clash, V2Ray). Uncomment if Node.js cannot reach WP directly.
# HTTPS_PROXY=http://127.0.0.1:7890

RATE_LIMIT_MS=120
RETRY_COUNT=3

DB_PATH=state/media-optimizer.db
CACHE_ORIGINAL_DIR=cache/original
CACHE_OPTIMIZED_DIR=cache/optimized
BACKUP_REMOTE_DIR=backup/remote
